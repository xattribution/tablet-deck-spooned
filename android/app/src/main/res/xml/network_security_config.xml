<?xml version="1.0" encoding="utf-8"?>
<!-- The deck is served over plain HTTP by a PC on the home network. Android can't scope
     cleartext to private IP ranges (domain-config matches host names, not subnets), so
     cleartext is allowed here; the app only loads the PC the player picks. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
