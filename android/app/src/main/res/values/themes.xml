<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark from the first frame: no white flash between the splash, the window and the WebView. -->
    <style name="Theme.TabletDeck" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:colorBackground">@color/ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:windowActivityTransitions">false</item>
    </style>

    <style name="Theme.TabletDeck.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.TabletDeck</item>
        <item name="android:windowBackground">@color/ground</item>
    </style>
</resources>
